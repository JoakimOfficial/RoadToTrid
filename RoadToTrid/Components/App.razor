<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="css/bootstrapTheme.css" />
    <link rel="stylesheet" href="css/site.css" />
    <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: false)" />
</head>
<body>
    <div id="startup-loader" class="startup-loader" role="status" aria-live="polite">
        <div class="startup-loader-content">
            <span class="spinner-border startup-loader-spinner" aria-hidden="true"></span>
            <strong class="startup-loader-title">Road to Trid</strong>
            <span id="startup-loader-message">Loading...</span>
            <a id="startup-loader-reload" href="" class="btn btn-primary" hidden>Reload</a>
        </div>
    </div>
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    <script src="js/app.js"></script>
    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script>Blazor.start().catch(window.roadToTrid.startupFailed);</script>
</body>
</html>
