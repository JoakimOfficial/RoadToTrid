@inherits LayoutComponentBase
@inject IJSRuntime JS

<header class="app-header">
    <nav class="navbar navbar-expand app-nav">
        <div class="container app-shell">
            <NavLink class="navbar-brand text-white" href="" Match="NavLinkMatch.All">Road to Trid</NavLink>
            <div class="navbar-nav flex-row gap-3">
                <NavLink class="nav-link text-white d-inline-flex align-items-center gap-1" href="Documentation">
                    <i class="bi bi-book" aria-hidden="true"></i><span>Documentation</span>
                </NavLink>
                <NavLink class="nav-link text-white d-inline-flex align-items-center gap-1" href="Settings">
                    <i class="bi bi-gear" aria-hidden="true"></i><span>Settings</span>
                </NavLink>
            </div>
        </div>
    </nav>
</header>
<main class="container app-shell py-3">@Body</main>
<div id="blazor-error-ui" role="alert">
    An unexpected error occurred. <a href="" class="reload">Reload</a>
    <button class="dismiss" type="button" aria-label="Dismiss">&#215;</button>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("roadToTrid.hideStartupLoader");
        }
    }
}
