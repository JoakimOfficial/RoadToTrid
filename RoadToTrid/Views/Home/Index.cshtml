@model HomeUploadViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Home";
}

<section class="card mb-3">
    <div class="card-body">
        <h1 class="h5">Instructions</h1>
        <p class="mb-3">Upload one or more XML files from Koha. The file(s) will be transformed into new XML file(s) for export to TRID.</p>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
        }

        <form asp-action="Upload" method="post" enctype="multipart/form-data" class="d-grid gap-3">
            @Html.AntiForgeryToken()
            <input class="form-control" type="file" name="files" multiple accept=".xml" />
            <div>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-upload" aria-hidden="true"></i>
                    Upload
                </button>
            </div>
        </form>
    </div>
</section>

@if (Model.Files.Count > 0)
{
    <div class="accordion" id="processedFiles">
        @for (var i = 0; i < Model.Files.Count; i++)
        {
            var file = Model.Files[i];
            var headingId = $"file-heading-{i}";
            var collapseId = $"file-collapse-{i}";
            var isDone = file.Status == FileProcessingStatus.Done;
            var hasWarnings = file.InvalidAbstracts.Count > 0;
            var statusClass = isDone ? hasWarnings ? "text-warning" : "text-success" : "text-danger";
            var statusIcon = isDone ? hasWarnings ? "bi-exclamation-triangle-fill" : "bi-check-square-fill" : "bi-x-circle-fill";

            <div class="accordion-item">
                <h2 class="accordion-header" id="@headingId">
                    <button class="accordion-button @(i == 0 ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="@(i == 0 ? "true" : "false")" aria-controls="@collapseId">
                        <span class="file-title">
                            <span>@file.InputFileName</span>
                            <span class="text-secondary">(@file.InputFileSize kb)</span>
                            <span class="@statusClass">
                                <i class="bi @statusIcon" aria-hidden="true"></i>
                                @file.Status
                            </span>
                        </span>
                    </button>
                </h2>
                <div id="@collapseId" class="accordion-collapse collapse @(i == 0 ? "show" : "")" aria-labelledby="@headingId" data-bs-parent="#processedFiles">
                    <div class="accordion-body">
                        @if (file.Status == FileProcessingStatus.Failed)
                        {
                            <div class="alert alert-danger" role="alert">
                                <h3 class="h6">Something went wrong</h3>
                                <p class="mb-0">@file.ErrorMessage</p>
                            </div>
                        }

                        @if (file.Status == FileProcessingStatus.Done)
                        {
                            <div class="alert alert-success d-flex flex-wrap justify-content-between align-items-center gap-2" role="alert">
                                <strong>Converted file: @file.OutputFileName</strong>
                                <form asp-action="Download" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="fileName" value="@file.OutputFileName" />
                                    <input type="hidden" name="content" value="@Convert.ToBase64String(file.OutPutXmlFileBytes)" />
                                    <button type="submit" class="btn btn-outline-success">
                                        <i class="bi bi-download" aria-hidden="true"></i>
                                        Download
                                    </button>
                                </form>
                            </div>

                            @foreach (var invalidAbstract in file.InvalidAbstracts)
                            {
                                if (string.IsNullOrWhiteSpace(invalidAbstract.AbstractText))
                                {
                                    <div class="alert alert-warning" role="alert">
                                        <h3 class="h6">Missing Abstract</h3>
                                        <strong>Record @invalidAbstract.RecordNumber does not contain an English abstract and has been included with an empty abstract.</strong>
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-warning" role="alert">
                                        <h3 class="h6">Removed Abstract</h3>
                                        <strong>In record @invalidAbstract.RecordNumber, the abstract has been removed due to the presence of invalid character(s):</strong>
                                    </div>
                                    <div class="border rounded p-3 mb-3">
                                        <p>
                                            @{
                                                var enumerator = StringInfo.GetTextElementEnumerator(invalidAbstract.AbstractText);
                                                var elementIndex = 0;

                                                while (enumerator.MoveNext())
                                                {
                                                    string textElement = enumerator.GetTextElement();

                                                    if (invalidAbstract.Indexes.Contains(elementIndex))
                                                    {
                                                        <span class="text-danger">@textElement</span>
                                                    }
                                                    else
                                                    {
                                                        @textElement
                                                    }

                                                    elementIndex++;
                                                }
                                            }
                                        </p>
                                        <button type="button" class="btn btn-outline-secondary copy-button" data-copy-text="@invalidAbstract.AbstractText">
                                            <i class="bi bi-clipboard" aria-hidden="true"></i>
                                            Copy
                                        </button>
                                    </div>
                                }
                            }
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
