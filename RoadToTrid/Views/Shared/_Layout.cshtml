<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Road to Trid</title>
    <link rel="icon" type="image/png" href="~/favicon.png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/bootstrapTheme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <nav class="navbar navbar-expand app-nav">
            <div class="container app-shell">
                <a class="navbar-brand text-white" asp-controller="Home" asp-action="Index">Road to Trid</a>
                <div class="navbar-nav flex-row gap-3">
                    <a class="nav-link text-white" asp-controller="Home" asp-action="Documentation">
                        <i class="bi bi-book" aria-hidden="true"></i>
                        <span>Documentation</span>
                    </a>
                    <a class="nav-link text-white" asp-controller="Home" asp-action="Settings">
                        <i class="bi bi-gear" aria-hidden="true"></i>
                        <span>Settings</span>
                    </a>
                </div>
            </div>
        </nav>
    </header>

    <main class="container app-shell py-3">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
