@model ErrorViewModel

@{
    ViewData["Title"] = "Error";
}

<section class="card">
    <div class="card-body">
        <h1 class="h4 text-danger">Error</h1>
        <p>An error occurred while processing your request.</p>

        @if (Model.ShowRequestId)
        {
            <p>
                <strong>Request ID:</strong>
                <code>@Model.RequestId</code>
            </p>
        }
    </div>
</section>
