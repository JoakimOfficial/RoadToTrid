<?xml version="1.0" encoding="windows-1252"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.transguide.org" xmlns="http://www.transguide.org" elementFormDefault="qualified">

<xs:attribute name="database">
  <xs:simpleType>
    <xs:restriction base="xs:string">
      <xs:pattern value="([a-zA-Z])*"/>
    </xs:restriction>
  </xs:simpleType>
</xs:attribute>

<xs:attribute name="record_no">
  <xs:simpleType>
    <xs:restriction base="xs:integer">
      <xs:pattern value="([0-9])*"/>
    </xs:restriction>
  </xs:simpleType>
</xs:attribute>

</xs:schema>